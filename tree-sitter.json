{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "razor_csharp",
      "camelcase": "RazorCSharp",
      "title": "Razor C#",
      "scope": "source.razor_csharp",
      "file-types": [
        "razor"
      ],
      "injection-regex": "^razor_csharp$",
      "class-name": "TreeSitterRazorCsharp"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Treesitter grammar for Razor C#",
    "authors": [
      {
        "name": "Pei Yang Ching",
        "url": "https://github.com/horriblename"
      }
    ],
    "links": {
      "repository": "https://github.com/horriblename/tree-sitter-razor-csharp"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
